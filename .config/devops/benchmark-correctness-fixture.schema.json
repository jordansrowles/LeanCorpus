{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leancorpus.dev/schemas/benchmark-correctness-fixture.schema.json",
  "title": "LeanCorpus deterministic benchmark correctness fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "deterministic", "seed", "domain", "input", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureId": { "type": "string", "pattern": "^bval-(0[1-9]|1[0-5])-[a-z0-9-]+$" },
    "deterministic": { "const": true },
    "seed": { "type": "integer", "minimum": 0 },
    "domain": { "type": "string", "minLength": 1 },
    "input": { "type": "object", "minProperties": 1 },
    "expected": { "type": "object", "minProperties": 1 }
  }
}
