{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leancorpus.dev/schemas/benchmark-cases.schema.json",
  "title": "LeanCorpus benchmark case families",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseFamilies", "exclusions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseFamilies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caseFamily" }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "caseFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "project", "benchmarkClass", "benchmarkMethods", "engineId", "category",
        "operation", "datasetProfile", "workloadId", "algorithmFamily", "cachePolicy",
        "lifecyclePolicy", "comparisonGroup", "classification", "resultContract", "qualityProof",
        "metrics", "estimatedBudget"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "project": { "$ref": "#/$defs/stableId" },
        "benchmarkClass": { "type": "string", "minLength": 1 },
        "benchmarkMethods": { "$ref": "#/$defs/stringArray" },
        "methodAliases": { "$ref": "#/$defs/stringArray" },
        "parameterValues": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringArray" }
        },
        "semanticParameters": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "engineId": {
          "enum": ["leancorpus", "lucenenet", "reference-scalar", "reference-java-lucene", "system"]
        },
        "category": {
          "enum": ["Index", "Search", "Analysis", "Storage", "Vector", "Spatial", "Lifecycle", "Diagnostic"]
        },
        "operation": { "type": "string", "minLength": 1 },
        "datasetProfile": { "type": "string", "minLength": 1 },
        "workloadId": { "$ref": "#/$defs/stableId" },
        "algorithmFamily": { "type": "string", "minLength": 1 },
        "cachePolicy": {
          "enum": ["Disabled", "UncachedExpansion", "WarmExpansion", "WarmResults", "Mixed", "NotApplicable"]
        },
        "lifecyclePolicy": {
          "enum": ["existing-index", "new-index", "cold-open", "warm-open", "commit", "merge", "refresh", "NotApplicable"]
        },
        "comparisonGroup": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "classification": {
          "enum": ["StrictParity", "QualifiedParity", "Directional", "InternalReference", "Unqualified"]
        },
        "resultContract": { "type": "string", "minLength": 1 },
        "qualityProof": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "unit", "role"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "unit": { "type": "string", "minLength": 1 },
              "role": { "enum": ["primary", "secondary"] }
            }
          },
          "contains": { "properties": { "role": { "const": "primary" } } },
          "minContains": 1,
          "maxContains": 1
        },
        "estimatedBudget": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "enum": ["StrictParity", "QualifiedParity"] } } },
          "then": { "properties": { "comparisonGroup": { "$ref": "#/$defs/stableId" } } }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "benchmarkClass", "benchmarkMethod", "reason", "expiresOn"],
      "properties": {
        "project": { "$ref": "#/$defs/stableId" },
        "benchmarkClass": { "type": "string", "minLength": 1 },
        "benchmarkMethod": { "type": "string", "minLength": 1 },
        "parameterValues": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringArray" }
        },
        "reason": { "type": "string", "minLength": 1 },
        "expiresOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
