{{!include(/^public/.*/)}}
{{!include(favicon.ico)}}
{{!include(logo.svg)}}
<!DOCTYPE html>
<html {{#_lang}}lang="{{_lang}}"{{/_lang}}>
  <head>
    <meta charset="utf-8">
    {{#redirect_url}}
      <meta http-equiv="refresh" content="0;URL='{{redirect_url}}'">
    {{/redirect_url}}
    {{^redirect_url}}
      <title>{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta name="title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}">
      {{#_description}}<meta name="description" content="{{_description}}">{{/_description}}
      {{#description}}<meta name="description" content="{{description}}">{{/description}}
      <link rel="icon" href="{{_rel}}{{{_appFaviconPath}}}{{^_appFaviconPath}}favicon.ico{{/_appFaviconPath}}">
      <link rel="stylesheet" href="{{_rel}}public/docfx.min.css">
      <link rel="stylesheet" href="{{_rel}}assets/site.css">
      <link rel="stylesheet" href="{{_rel}}public/main.css">
      <link rel="stylesheet" href="{{_rel}}assets/api-icons/api-icons.css">
      <meta name="docfx:navrel" content="{{_rel}}toc.html">
      <meta name="docfx:tocrel" content="{{_rel}}toc.html">
      {{#_noindex}}<meta name="searchOption" content="noindex">{{/_noindex}}
      {{#_enableSearch}}<meta name="docfx:rel" content="{{_rel}}">{{/_enableSearch}}
      {{^_enableSearch}}<meta name="docfx:rel" content="{{_rel}}">{{/_enableSearch}}
      {{#_disableNewTab}}<meta name="docfx:disablenewtab" content="true">{{/_disableNewTab}}
      {{#_disableTocFilter}}<meta name="docfx:disabletocfilter" content="true">{{/_disableTocFilter}}
      {{#docurl}}<meta name="docfx:docurl" content="{{docurl}}">{{/docurl}}
      <meta name="loc:inThisArticle" content="{{__global.inThisArticle}}">
      <meta name="loc:searchResultsCount" content="{{__global.searchResultsCount}}">
      <meta name="loc:searchNoResults" content="{{__global.searchNoResults}}">
      <meta name="loc:tocFilter" content="{{__global.tocFilter}}">
      <meta name="loc:nextArticle" content="{{__global.nextArticle}}">
      <meta name="loc:prevArticle" content="{{__global.prevArticle}}">
      <meta name="loc:themeLight" content="{{__global.themeLight}}">
      <meta name="loc:themeDark" content="{{__global.themeDark}}">
      <meta name="loc:themeAuto" content="{{__global.themeAuto}}">
      <meta name="loc:changeTheme" content="{{__global.changeTheme}}">
      <meta name="loc:copy" content="{{__global.copy}}">
      <meta name="loc:downloadPdf" content="{{__global.downloadPdf}}">

      <script src="{{_rel}}assets/diagram-renderer.js" defer></script>
      <script type="module" src="./{{_rel}}public/docfx.min.js"></script>
      <script src="{{_rel}}assets/api-icons/api-icons.js" defer></script>
      <script src="{{_rel}}assets/section-navigation.js" defer></script>
      <script src="{{_rel}}assets/display-settings.js" defer></script>
      <script>
        (() => {
          const root = document.documentElement
          const readPreference = (key, fallback) => {
            try {
              return localStorage.getItem(key) || fallback
            } catch {
              return fallback
            }
          }
          const theme = readPreference('theme', 'auto')
          const contentSize = readPreference('content-size', 'default')
          const validTheme = ['light', 'dark', 'auto'].includes(theme) ? theme : 'auto'
          const validContentSize = ['compact', 'default', 'large', 'x-large'].includes(contentSize) ? contentSize : 'default'
          root.dataset.contentSize = validContentSize
          root.setAttribute('data-bs-theme', validTheme === 'auto' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : validTheme)
        })()
      </script>

      {{#_googleAnalyticsTagId}}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{_googleAnalyticsTagId}}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{_googleAnalyticsTagId}}');
      </script>
      {{/_googleAnalyticsTagId}}
    {{/redirect_url}}
  </head>

  {{^redirect_url}}
  <body class="tex2jax_ignore" data-layout="{{_layout}}{{layout}}" data-yaml-mime="{{yamlmime}}" data-root-toc="{{_rel}}toc.json" data-api-root="{{_rel}}api/" data-api-toc="{{_rel}}api/toc.json">
    <header class="lc-topbar border-bottom">
      <nav class="container-xxl lc-topnav" aria-label="Main navigation">
        <a class="lc-brand" href="{{_appLogoUrl}}{{^_appLogoUrl}}{{_rel}}index.html{{/_appLogoUrl}}">{{_appName}}</a>
        <div class="lc-topnav-links">
          <a data-section="About" href="{{_rel}}about/index.html">About</a>
          <a data-section="Guides" href="{{_rel}}guides/index.html">Guides</a>
          <a data-section="Contribute" href="{{_rel}}contributors/index.html">Contribute</a>
          <a data-section="API" href="{{_rel}}api/index.html">API</a>
          <a data-section="Reference" href="{{_rel}}reference/index.html">Reference</a>
        </div>
        <div class="lc-topnav-tools">
          <button class="lc-icon-button" id="lc-theme-toggle" type="button" title="Theme: system" aria-label="Change colour theme">🌓</button>
          <button class="lc-icon-button lc-text-size-button" id="lc-text-size-toggle" type="button" title="Text size: default" aria-label="Change text size">A</button>
          {{#_enableSearch}}
          <form class="search lc-header-search" role="search" id="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="form-control" id="search-query" type="search" disabled placeholder="{{__global.search}}" autocomplete="off" aria-label="Search documentation">
          </form>
          {{/_enableSearch}}
        </div>
      </nav>
    </header>
    <main class="container-xxl lc-docs-layout">
      <div class="toc-offcanvas">
        <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="tocOffcanvas" aria-labelledby="tocOffcanvasLabel">
          <div class="offcanvas-header">
            <span class="offcanvas-title" id="tocOffcanvasLabel">Section navigation</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#tocOffcanvas" aria-label="Close"></button>
          </div>
          <div class="offcanvas-body">
            <div class="lc-main-navigation">
              <div class="lc-section-heading" id="lcSectionHeading"></div>
              <nav class="toc lc-docs-tree" id="lcToc" aria-label="Section table of contents">
                <p class="text-secondary small">Loading section navigation...</p>
              </nav>
            </div>
          </div>
        </div>
      </div>

      <div class="content">
        <div class="actionbar">
          <button class="btn btn-lg border-0 d-lg-none"
              type="button" data-bs-toggle="offcanvas" data-bs-target="#tocOffcanvas"
              aria-controls="tocOffcanvas" aria-expanded="false" aria-label="Show table of contents">
            <i class="bi bi-list"></i>
          </button>

          {{^_disableBreadcrumb}}
          <nav id="breadcrumb"></nav>
          {{/_disableBreadcrumb}}
        </div>

        {{#_enableSearch}}
        <section class="search-results lc-search-results" id="search-results" aria-live="polite"></section>
        {{/_enableSearch}}

        <article data-uid="{{uid}}">
          {{!body}}
        </article>

        {{^_disableContribution}}
        <div class="contribution d-print-none">
          {{#sourceurl}}
          <a href="{{sourceurl}}" class="edit-link">{{__global.improveThisDoc}}</a>
          {{/sourceurl}}
          {{^sourceurl}}{{#docurl}}
          <a href="{{docurl}}" class="edit-link">{{__global.improveThisDoc}}</a>
          {{/docurl}}{{/sourceurl}}
        </div>
        {{/_disableContribution}}

        {{^_disableNextArticle}}
        <div class="next-article d-print-none border-top" id="nextArticle"></div>
        {{/_disableNextArticle}}

      </div>

      {{^_disableAffix}}
      <div class="affix">
        <nav id="affix"></nav>
      </div>
      {{/_disableAffix}}
    </main>

    <footer class="border-top text-secondary">
      <div class="container-xxl">
        <div class="flex-fill">
          {{{_appFooter}}}{{^_appFooter}}<span>Made with <a href="https://dotnet.github.io/docfx">docfx</a></span>{{/_appFooter}}
        </div>
      </div>
    </footer>
  </body>
  {{/redirect_url}}
</html>
