{
  "metadata": [
    {
      "src": [
        {
          "files": [ "Rowles.LeanCorpus.csproj" ],
          "src": "../src/core/Rowles.LeanCorpus"
        },
        {
          "files": [ "Rowles.LeanCorpus.Compression.LZ4.csproj" ],
          "src": "../src/core/Rowles.LeanCorpus.Compression.LZ4"
        },
        {
          "files": [ "Rowles.LeanCorpus.Compression.Snappy.csproj" ],
          "src": "../src/core/Rowles.LeanCorpus.Compression.Snappy"
        },
        {
          "files": [ "Rowles.LeanCorpus.Compression.Zstandard.csproj" ],
          "src": "../src/core/Rowles.LeanCorpus.Compression.Zstandard"
        },
        {
          "files": [ "Rowles.LeanCorpus.SourceGen.csproj" ],
          "src": "../src/core/Rowles.LeanCorpus.SourceGen"
        }
      ],
      "dest": "../artifacts/docs/api",
      "filter": "filterConfig.yml",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages",
      "allowCompilationErrors": false,
      "includePrivateMembers": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**.yml" ],
        "src": "../artifacts/docs/api",
        "dest": "api"
      },
      {
        "files": [ "index.md" ],
        "src": "api",
        "dest": "api"
      },
      {
        "files": [ "*.md", "toc.yml" ]
      },
      {
        "files": [ "getting-started/**.md" ],
        "exclude": [ "getting-started/04-source-generated-mapping.md" ]
      },
      {
        "files": [ "concepts/**.md" ]
      },
      {
        "files": [ "about/**.md", "guides/**.md" ]
      },
      {
        "files": [ "reference/**.md" ]
      },
      {
        "files": [ "analysis/**.md" ],
        "exclude": [ "analysis/06-lexicons.md", "analysis/08-rowles-text.md" ]
      },
      {
        "files": [ "searching/**.md" ]
      },
      {
        "files": [ "advanced/**.md" ]
      },
      {
        "files": [ "concurrency/**.md" ]
      },
      {
        "files": [ "index-management/**.md" ]
      },
      {
        "files": [ "observability/**.md" ]
      },
      {
        "files": [ "server/**.md" ]
      },
      {
        "files": [ "tips/**.md" ]
      },
      {
        "files": [ "contributors/**.md" ],
        "exclude": [ "contributors/index.md" ]
      },
      {
        "files": [ "**.md" ],
        "src": "../artifacts/docs/generated/repository",
        "dest": ".generated"
      },
      {
        "files": [ "articles/**.md" ]
      },
      {
        "files": [ "*.md" ],
        "src": "../artifacts/docs/generated/benchmarks",
        "dest": "benchmarks"
      },
      {
        "files": [ "changelog/**.md" ]
      }
    ],
    "output": "../artifacts/docs/site",
    "template": [ "default", "modern", "templates/leancorpus" ],
    "resource": [
      {
        "files": [ "assets/**" ]
      },
      {
        "files": [ "*.json", "benchmark-charts.js" ],
        "src": "../artifacts/docs/generated/benchmarks",
        "dest": "benchmarks"
      },
      {
        "files": [ "**" ],
        "src": "../artifacts/docs/coverage",
        "dest": "coverage"
      }
    ],
    "globalMetadata": {
      "_appTitle": "LeanCorpus 3.1.0",
      "_appName": "LeanCorpus 3.1.0",
      "_appFooter": "LeanCorpus: a fast, embeddable full-text search engine for .NET",
      "_enableSearch": true,
      "categoryLayout": "nested"
    }
  }
}
