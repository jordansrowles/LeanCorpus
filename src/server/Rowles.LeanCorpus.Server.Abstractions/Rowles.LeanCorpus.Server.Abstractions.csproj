<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Features>runtime-async=on</Features>
    <PackageId>Rowles.LeanCorpus.Server.Abstractions</PackageId>
    <Version>0.1.0-alpha.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Jordan Rowles</Authors>
    <Description>Transport-neutral contracts and extension points for LeanCorpus Server.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jordansrowles/LeanCorpus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="Contracts\OpenApi\*.json" Pack="true" PackagePath="contracts\openapi" />
    <None Include="Contracts\Grpc\*.proto" Pack="true" PackagePath="contracts\grpc" />
  </ItemGroup>

</Project>
