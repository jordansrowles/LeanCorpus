{
  "openapi": "3.1.0",
  "info": { "title": "LeanCorpus Server API", "version": "1" },
  "paths": {
    "/v1/health": { "get": { "operationId": "getHealth" } },
    "/v1/ready": { "get": { "operationId": "getReadiness" } },
    "/v1/indices": { "get": { "operationId": "listIndices" } },
    "/v1/indices/{name}": { "put": { "operationId": "createIndex" }, "delete": { "operationId": "deleteIndex" } },
    "/v1/indices/{name}/settings": { "patch": { "operationId": "updateIndexSettings" } },
    "/v1/indices/{name}/documents:bulk": { "post": { "operationId": "bulkDocuments" } },
    "/v1/indices/{name}/refresh": { "post": { "operationId": "refreshIndex" } },
    "/v1/indices/{name}/search": { "post": { "operationId": "searchIndex" } },
    "/v1/indices/{name}/schema": { "get": { "operationId": "getIndexSchema" } },
    "/v1/indices/{name}/stats": { "get": { "operationId": "getIndexStatistics" } },
    "/v1/indices/{name}/inspection/{resource}": { "get": { "operationId": "inspectIndex" } },
    "/v1/cluster": { "get": { "operationId": "getCluster" } },
    "/v1/indices/{name}/shards": { "get": { "operationId": "getIndexShards" } },
    "/v1/admin/nodes/{id}:drain": { "post": { "operationId": "drainNode" } },
    "/v1/admin/shards/{id}:recover": { "post": { "operationId": "recoverShard" } },
    "/v1/admin/license": { "get": { "operationId": "getLicence" } },
    "/v1/admin/license:validate": { "post": { "operationId": "validateLicence" } },
    "/v1/admin/snapshots": { "post": { "operationId": "createSnapshot" } },
    "/v1/admin/snapshots/{id}:restore": { "post": { "operationId": "restoreSnapshot" } },
    "/v1/admin/diagnostics": { "get": { "operationId": "getDiagnostics" } }
  }
}
