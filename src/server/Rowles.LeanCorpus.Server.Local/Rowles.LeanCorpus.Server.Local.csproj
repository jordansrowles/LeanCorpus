<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <OutputType>Exe</OutputType>
    <AssemblyName>Rowles.LeanCorpus.Server.Local</AssemblyName>
    <RootNamespace>Rowles.LeanCorpus.Server.Local</RootNamespace>
    <PackageId>Rowles.LeanCorpus.Server.Local</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Jordan Rowles</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jordansrowles/LeanCorpus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>Reference executable for the local LeanCorpus Community Server.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <ProjectReference Include="../Rowles.LeanCorpus.Server.Core/Rowles.LeanCorpus.Server.Core.csproj" />
    <ProjectReference Include="../Rowles.LeanCorpus.Server.AspNetCore/Rowles.LeanCorpus.Server.AspNetCore.csproj" />
    <ProjectReference Include="../Rowles.LeanCorpus.Server.Grpc/Rowles.LeanCorpus.Server.Grpc.csproj" />
    <ProjectReference Include="../Rowles.LeanCorpus.Studio/Rowles.LeanCorpus.Studio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
