{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "LeanCorpus": {
    "DataRoot": "data",
    "MaximumRequestBodyBytes": 104857600,
    "MaximumUncommittedOperations": 1000,
    "Listeners": ["http://127.0.0.1:5080", "http://[::1]:5080"]
  }
}
