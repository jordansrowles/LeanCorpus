<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <PackageId>Rowles.LeanCorpus.OrchardCore.Search</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Jordan Rowles</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jordansrowles/LeanCorpus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Embedded LeanCorpus indexing and search provider for Orchard Core.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rowles.LeanCorpus.OrchardCore.Search.Tests" />
    <InternalsVisibleTo Include="Rowles.LeanCorpus.OrchardCore.Search.FunctionalTests" />
    <InternalsVisibleTo Include="Rowles.LeanCorpus.OrchardCore.Search.TestHost" />
    <InternalsVisibleTo Include="Rowles.LeanCorpus.OrchardCore.Search.TestModule" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Indexing" />
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Queries" />
    <PackageReference Include="OrchardCore.Search" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/Rowles.LeanCorpus/Rowles.LeanCorpus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
