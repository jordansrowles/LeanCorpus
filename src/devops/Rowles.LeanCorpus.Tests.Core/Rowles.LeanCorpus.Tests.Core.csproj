<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Rowles.LeanCorpus\Rowles.LeanCorpus.csproj" />
    <ProjectReference Include="..\..\core\Rowles.LeanCorpus.Compression.LZ4\Rowles.LeanCorpus.Compression.LZ4.csproj" />
    <ProjectReference Include="..\..\core\Rowles.LeanCorpus.Compression.Snappy\Rowles.LeanCorpus.Compression.Snappy.csproj" />
    <ProjectReference Include="..\..\core\Rowles.LeanCorpus.Compression.Zstandard\Rowles.LeanCorpus.Compression.Zstandard.csproj" />
    <ProjectReference Include="..\Rowles.LeanCorpus.Cli\Rowles.LeanCorpus.Cli.csproj" />
  </ItemGroup>

  <!-- Shared infrastructure: xunit-agnostic fixtures sourced into this project. -->
  <ItemGroup>
    <Compile Include="..\Rowles.LeanCorpus.Tests.Shared\Fixtures\TestDirectoryFixture.cs"
             Link="Foundation\Infrastructure\TestDirectoryFixture.cs" />
    <Compile Include="..\Rowles.LeanCorpus.Tests.Shared\Fixtures\HistoricalCodecFixtures.cs"
             Link="Foundation\Infrastructure\HistoricalCodecFixtures.cs" />
    <Compile Include="..\Rowles.LeanCorpus.Tests.Shared\Fixtures\HistoricalIndexFixtures.cs"
             Link="Foundation\Infrastructure\HistoricalIndexFixtures.cs" />
    <Compile Include="..\Rowles.LeanCorpus.Tests.Shared\Infrastructure\MaterialisingTokenSink.cs"
             Link="Foundation\Infrastructure\MaterialisingTokenSink.cs" />
    <Compile Include="..\Rowles.LeanCorpus.Tests.Shared\Metamorphic\MetamorphicRelations.cs"
             Link="Foundation\Metamorphic\MetamorphicRelations.cs" />
  </ItemGroup>

  <!-- Historical fixture bytes: keep the manifest names stable regardless of project. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Rowles.LeanCorpus.Tests.Shared\Fixtures\Indexes\*.fixture.b64"
                      Link="Fixtures\Indexes\%(Filename)%(Extension)"
                      LogicalName="Rowles.LeanCorpus.Tests.Shared.Fixtures.Indexes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\lexicons\japanese.jlc"
             Link="lexicons\japanese.jlc"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
