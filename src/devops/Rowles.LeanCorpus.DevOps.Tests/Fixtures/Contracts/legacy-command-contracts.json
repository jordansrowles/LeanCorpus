      "id": "report-git-json",
      "command": "report",
      "legacyTokens": [
        "git",
        "-Json"
      ],
      "expectedRequest": {
        "group": "git",
        "top": 10,
        "path": null,
        "strict": false,
        "json": true
      },
      "expectedExternalCommand": null,
      "expectedOutcome": "report-outcome-with-versioned-envelope",
      "expectedEvidence": {
        "runRoot": "artifacts/report/runs/<run-id>",
        "contractVersion": 1,
        "sourceIdentity": true,
        "childAttempts": true,
        "logRefs": true
      },
      "platformRestrictions": [],
      "intentionalChange": "NUL-safe Git parsing retains churn from similarity-detected renames that the legacy text parser dropped; deterministic tie ordering is used for ranked files and commits."
    },
