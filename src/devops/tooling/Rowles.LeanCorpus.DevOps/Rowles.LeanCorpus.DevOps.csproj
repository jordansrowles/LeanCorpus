<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyName Condition="'$(DevOpsDistributionProfile)' != 'Tool'">leancorpus-devops</AssemblyName>
    <UseAppHost Condition="'$(DevOpsDistributionProfile)' != 'Tool'">true</UseAppHost>
    <RuntimeIdentifiers Condition="'$(DevOpsDistributionProfile)' != 'Tool'">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DevOpsDistributionProfile)' == 'Tool'">
    <AssemblyName>devops</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Rowles.LeanCorpus.DevOps</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.tool.lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Jordan Rowles</Authors>
    <Description>Managed command-line tooling for building, testing, documenting, validating and packaging LeanCorpus.</Description>
    <PackageTags>leancorpus;devops;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENCE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/jordansrowles/LeanCorpus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ToolCommandName>devops</ToolCommandName>
    <UseAppHost>false</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers></ToolPackageRuntimeIdentifiers>
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DevOpsDistributionProfile)' == 'ReleaseArchive'">
    <AssemblyName>devops</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.distribution.lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bullseye" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="CliWrap" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="Spectre.Console" />
    <InternalsVisibleTo Include="Rowles.LeanCorpus.DevOps.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../dataforge/shared/DataForgeHelp.cs" Link="DataForge/DataForgeHelp.cs" />
    <Compile Include="../../dataforge/shared/DataForgeProfileOptions.cs" Link="DataForge/DataForgeProfileOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Packaging/Assets/Consumer.csproj.template">
      <LogicalName>Rowles.LeanCorpus.DevOps.Packaging.Assets.Consumer.csproj.template</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Packaging/Assets/Program.cs.template">
      <LogicalName>Rowles.LeanCorpus.DevOps.Packaging.Assets.Program.cs.template</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Packaging/Assets/ConsumerSources/*.cs.txt">
      <LogicalName>Rowles.LeanCorpus.DevOps.Packaging.Assets.ConsumerSources.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(DevOpsDistributionProfile)' == 'Tool'">
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENCE" Pack="true" PackagePath="/" />
    <None Include="Licenses/**/*" Pack="true" PackagePath="licenses/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
